# --- Environment variables ---
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging

# --- Backend config (bisa berisi DB / payment credentials asli) ---
be/config/secrets.php
be/config/database.local.php
be/config/*.secret.php

# --- API keys & credentials files ---
credentials.*
secret*
*credential*.json
*service-account*.json
serviceAccountKey.json
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
known_hosts
authorized_keys
.htpasswd
.netrc

# --- Deploy & hosting credentials ---
docs/DEPLOY_ONYX.md
docs/deploy*.md

